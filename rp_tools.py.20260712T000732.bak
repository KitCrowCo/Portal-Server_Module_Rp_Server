"""
RP Tools - dice roller, name generator, and generalized character sheets.
Mounted under /module/rp_server/tools/ by the main rp_server router.
Character sheets are template-driven (JSON files under data/rp_server/sheet_templates/)
so any game system's field list can be added without new code - nothing here is
hardcoded to a specific system.
"""
import re, json, random
from pathlib import Path
from fastapi import APIRouter, Request, Form
from .models import Persona, SessionLocal

router = APIRouter()
ENV = {}
UI = None

TEMPLATE_DIR = Path("./data/rp_server/sheet_templates")
SHEET_DIR = Path("./data/rp_server/sheets")

def init_module(env: dict):
    global ENV, UI
    ENV.update(env)
    UI = ENV["templates"].env.globals.get("UI")
    TEMPLATE_DIR.mkdir(parents=True, exist_ok=True)
    SHEET_DIR.mkdir(parents=True, exist_ok=True)
    _seed_default_template()

# --- Menu ---

from fastapi.responses import HTMLResponse

@router.get("/menu", response_class=HTMLResponse)
async def tools_menu(request: Request):
    return HTMLResponse(UI.modal("rp-tools", "RP Tools", """
        <div style="display:flex;flex-direction:column;gap:.5rem;">
            <button class="ui-btn" hx-get="/module/rp_server/tools/dice" hx-target="#rpt-body" hx-swap="innerHTML">&#x1F3B2; Dice Roller</button>
            <button class="ui-btn" hx-get="/module/rp_server/tools/names" hx-target="#rpt-body" hx-swap="innerHTML">&#x1F4DD; Name Generator</button>
            <button class="ui-btn" hx-get="/module/rp_server/tools/sheets" hx-target="#rpt-body" hx-swap="innerHTML">&#x1F4CB; Character Sheets</button>
        </div>
        <div id="rpt-body" style="margin-top:1rem;"></div>
    """))

# --- Dice Roller ---

_DICE_RE = re.compile(r'^\s*(\d*)d(\d+)\s*([+-]\s*\d+)?\s*$', re.I)

def _roll(expr: str) -> dict:
    m = _DICE_RE.match(expr)
    if not m: return {"error": f"Can't parse '{expr}'. Use NdM+K, e.g. 2d6+3."}
    n = int(m.group(1) or 1); sides = int(m.group(2))
    mod = int(re.sub(r'\s', '', m.group(3)) or 0) if m.group(3) else 0
    if n > 100 or sides > 1000: return {"error": "Too large - keep it under 100 dice / d1000."}
    rolls = [random.randint(1, sides) for _ in range(n)]
    return {"expr": expr.strip(), "rolls": rolls, "mod": mod, "total": sum(rolls) + mod}

@router.get("/dice", response_class=HTMLResponse)
async def dice_panel(request: Request):
    quick = "".join(f'<button type="button" class="cm-qbtn" onclick="this.closest(\'div\').previousElementSibling.querySelector(\'[name=expr]\').value=\'{p}\';htmx.trigger(this.closest(\'div\').previousElementSibling,\'submit\')">{p}</button>' for p in ["1d20","1d100","2d6","4d6","1d4","1d6","1d8","1d10","1d12"])
    return HTMLResponse(f"""<form hx-post="/module/rp_server/tools/dice/roll" hx-target="#dice-log" hx-swap="afterbegin" style="display:flex;gap:.4rem;">
        <input name="expr" value="1d20" class="module-select" style="flex:1;margin:0;" placeholder="2d6+3">
        <button class="ui-btn">Roll</button>
    </form>
    <div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-top:.4rem;">{quick}</div>
    <div id="dice-log" style="margin-top:.6rem;max-height:16rem;overflow-y:auto;display:flex;flex-direction:column;gap:.3rem;"></div>""")

@router.post("/dice/roll", response_class=HTMLResponse)
async def dice_roll(request: Request, expr: str = Form(...)):
    r = _roll(expr)
    if "error" in r: return HTMLResponse(f'<div style="font-size:.78rem;color:#ff5f5f;padding:.3rem .5rem;">{r["error"]}</div>')
    detail = " + ".join(str(x) for x in r["rolls"]) + (f" {'+' if r['mod']>=0 else '-'} {abs(r['mod'])}" if r["mod"] else "")
    return HTMLResponse(f"""<div class="glass" style="padding:.4rem .6rem;font-size:.8rem;display:flex;justify-content:space-between;gap:.5rem;">
        <span style="color:var(--text_muted);">{r["expr"]}: {detail}</span><b style="color:var(--accent);">{r["total"]}</b></div>""")

# --- Name Generator ---

_NAME_PARTS = {
    "fantasy_male":   (["Ael","Bran","Cade","Dor","Eryn","Fael","Gar","Hal","Ivor","Jor","Kael","Lorin","Mor","Nyle","Oren","Perth","Quen","Roth","Syl","Thal"], ["dric","wyn","ric","or","an","ion","eth","ard","in","us"]),
    "fantasy_female": (["Ael","Bri","Cael","Dae","Ely","Fael","Gwen","Hala","Isol","Jora","Kyra","Lira","Mira","Nyra","Ora","Phae","Quen","Ryn","Syl","Thera"], ["wen","lyn","ith","ara","el","ora","ine","yss","ana","el"]),
    "sci_fi":         (["Zar","Vex","Kry","Nol","Tev","Xan","Ory","Bel","Cix","Drun"], ["ax","on","ith","ar","ex","us","ion","yn","or","el"]),
    "surname":        (["Black","Storm","Iron","Wolf","Ash","Thorn","Grey","Stone","Wild","Frost"], ["wood","born","gard","holt","vale","moor","ridge","cliff","haven","reach"]),
}

@router.get("/names", response_class=HTMLResponse)
async def names_panel(request: Request):
    opts = "".join(f'<option value="{k}">{k.replace("_"," ").title()}</option>' for k in _NAME_PARTS)
    return HTMLResponse(f"""<div style="display:flex;gap:.4rem;">
        <select id="rpn-set" name="rpn_set" class="module-select" style="margin:0;flex:1;">{opts}</select>
        <button class="ui-btn" hx-get="/module/rp_server/tools/names/roll" hx-include="#rpn-set" hx-target="#rpn-out" hx-swap="innerHTML">Generate x8</button>
    </div>
    <div id="rpn-out" style="margin-top:.6rem;display:flex;flex-direction:column;gap:.2rem;font-size:.85rem;"></div>""")

@router.get("/names/roll", response_class=HTMLResponse)
async def names_roll(request: Request, rpn_set: str = "fantasy_male"):
    prefixes, suffixes = _NAME_PARTS.get(rpn_set, _NAME_PARTS["fantasy_male"])
    names = [random.choice(prefixes) + random.choice(suffixes) for _ in range(8)]
    return HTMLResponse("".join(f'<div style="display:flex;justify-content:space-between;padding:.15rem .3rem;border-bottom:var(--border-thick) solid var(--border);"><span>{n}</span><button class="cm-qbtn" onclick="navigator.clipboard.writeText(\'{n}\')">&#x2398;</button></div>' for n in names))

# --- Character Sheets (template-driven) ---

def _seed_default_template():
    default = TEMPLATE_DIR / "generic.json"
    if not default.exists():
        default.write_text(json.dumps({"name": "Generic", "fields": [
            {"key": "concept", "label": "Concept", "type": "text"},
            {"key": "appearance", "label": "Appearance", "type": "textarea"},
            {"key": "personality", "label": "Personality", "type": "textarea"},
            {"key": "background", "label": "Background", "type": "textarea"},
            {"key": "stats", "label": "Stats / Attributes", "type": "textarea"},
            {"key": "inventory", "label": "Inventory", "type": "textarea"},
            {"key": "notes", "label": "Notes", "type": "textarea"}
        ]}, indent=2), encoding="utf-8")

def _load_template(name: str) -> dict:
    p = TEMPLATE_DIR / f"{name}.json"
    return json.loads(p.read_text()) if p.exists() else json.loads((TEMPLATE_DIR / "generic.json").read_text())

def _sheet_path(username: str, persona_name: str) -> Path:
    safe = re.sub(r"[^a-zA-Z0-9_-]", "_", persona_name)
    return SHEET_DIR / f"{username}__{safe}.json"

@router.get("/sheets", response_class=HTMLResponse)
async def sheets_panel(request: Request):
    db = SessionLocal()
    try:
        username = request.state.user.username
        personas = [username] + [p.name for p in db.query(Persona).filter(Persona.owner_username == username).all()]
    finally: db.close()
    opts = "".join(f'<option value="{p}">{p}</option>' for p in personas)
    t_opts = "".join(f'<option value="{t.stem}">{t.stem}</option>' for t in TEMPLATE_DIR.glob("*.json"))
    return HTMLResponse(f"""<div style="display:flex;gap:.4rem;margin-bottom:.5rem;">
        <select id="rps-persona" class="module-select" style="margin:0;flex:1;">{opts}</select>
        <select id="rps-template" class="module-select" style="margin:0;flex:1;">{t_opts}</select>
        <button class="ui-btn" hx-get="/module/rp_server/tools/sheets/load" hx-include="#rps-persona,#rps-template" hx-target="#rps-form" hx-swap="innerHTML">Open</button>
    </div>
    <div id="rps-form"></div>""")

@router.get("/sheets/load", response_class=HTMLResponse)
async def sheets_load(request: Request, rps_persona: str, rps_template: str):
    username = request.state.user.username
    tmpl = _load_template(rps_template)
    path = _sheet_path(username, rps_persona)
    data = json.loads(path.read_text()) if path.exists() else {}
    rows = "".join(
        f'<label style="display:block;margin-bottom:.5rem;"><div style="font-size:.72rem;color:var(--text_muted);margin-bottom:.15rem;">{f["label"]}</div>' +
        (f'<textarea name="{f["key"]}" rows="3" class="module-select" style="width:100%;margin:0;">{data.get(f["key"],"")}</textarea>' if f["type"] == "textarea"
         else f'<input type="text" name="{f["key"]}" value="{data.get(f["key"],"")}" class="module-select" style="width:100%;margin:0;">') + '</label>'
        for f in tmpl["fields"])
    return HTMLResponse(f"""<form hx-post="/module/rp_server/tools/sheets/save" hx-target="#rps-status" hx-swap="innerHTML">
        <input type="hidden" name="persona_name" value="{rps_persona}">
        {rows}
        <button class="ui-btn" style="color:var(--accent);">Save Sheet</button>
        <span id="rps-status" style="font-size:.75rem;margin-left:.5rem;"></span>
    </form>""")

@router.post("/sheets/save", response_class=HTMLResponse)
async def sheets_save(request: Request, persona_name: str = Form(...)):
    username = request.state.user.username
    form = await request.form()
    data = {k: v for k, v in form.items() if k != "persona_name"}
    _sheet_path(username, persona_name).write_text(json.dumps(data, indent=2), encoding="utf-8")
    return HTMLResponse('<span style="color:var(--accent);">&#x2713; Saved</span>')